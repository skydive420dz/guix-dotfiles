#!/usr/bin/env -S guile --no-auto-compile -s
!#

;;; Bounded BlueZ control for the GuixPC Emacs surface.

(use-modules (ice-9 match)
             (ice-9 popen)
             (ice-9 textual-ports)
             (srfi srfi-1)
             (srfi srfi-13)
             (srfi srfi-14))

(define %program "sk-bluetooth")
(define %system-bin "/run/current-system/profile/bin")
(define %timeout (string-append %system-bin "/timeout"))
(define %busctl (string-append %system-bin "/busctl"))
(define %bluetoothctl (string-append %system-bin "/bluetoothctl"))
(define %bluez-service "org.bluez")
(define %adapter-interface "org.bluez.Adapter1")
(define %device-interface "org.bluez.Device1")
(define %properties-interface "org.freedesktop.DBus.Properties")
(define %audio-sink-uuid "0000110b-0000-1000-8000-00805f9b34fb")
(define %maximum-output 131072)

(define (command-result kind output)
  (list kind output))

(define (result-kind result)
  (car result))

(define (result-output result)
  (cadr result))

(define (status-success? status)
  (catch #t
    (lambda ()
      (let ((exit-value (status:exit-val status)))
        (and (integer? exit-value) (zero? exit-value))))
    (lambda _ #f)))

(define (run-command program arguments seconds)
  "Run PROGRAM with direct ARGUMENTS for at most SECONDS.
The shell is never involved.  Output and runtime are bounded."
  (if (or (not (file-exists? program))
          (not (access? program X_OK))
          (not (file-exists? %timeout)))
      (command-result 'unavailable "")
      (catch #t
        (lambda ()
          (let* ((outer-timeout (number->string (+ seconds 1)))
                 (port
                  (apply open-pipe* OPEN_READ %timeout
                         "--kill-after=1" outer-timeout
                         program arguments))
                 (_ (set-port-encoding! port "UTF-8"))
                 (output (get-string-n port (+ %maximum-output 1)))
                 (status (close-pipe port))
                 (text (if (eof-object? output) "" output)))
            (cond
             ((> (string-length text) %maximum-output)
              (command-result 'oversize ""))
             ((status-success? status)
              (command-result 'ok text))
             (else
              (command-result 'failed "")))))
        (lambda _ (command-result 'unavailable "")))))

(define sk:bluetooth-command-runner run-command)

(define (invoke program seconds . arguments)
  (sk:bluetooth-command-runner program arguments seconds))

(define (fail message)
  (throw 'sk-bluetooth-error message))

(define (require-ok result action)
  (unless (eq? (result-kind result) 'ok)
    (fail (string-append action " failed")))
  (result-output result))

(define (read-forms text)
  (catch #t
    (lambda ()
      (call-with-input-string text
        (lambda (port)
          (let loop ((forms '()))
            (let ((form (read port)))
              (if (eof-object? form)
                  (reverse forms)
                  (loop (cons form forms))))))))
    (lambda _ '())))

(define (decode-property text)
  (let ((forms (read-forms text)))
    (if (null? forms)
        'unknown
        (let ((signature (car forms))
              (payload (cdr forms)))
          (cond
           ((and (memq signature '(s o))
                 (= (length payload) 1)
                 (string? (car payload)))
            (car payload))
           ((and (eq? signature 'b) (= (length payload) 1))
            (case (car payload)
              ((true) 'yes)
              ((false) 'no)
              (else 'unknown)))
           ((and (memq signature '(y n q i u x t))
                 (= (length payload) 1)
                 (integer? (car payload)))
            (car payload))
           ((and (eq? signature 'as)
                 (pair? payload)
                 (integer? (car payload))
                 (= (car payload) (length (cdr payload)))
                 (every string? (cdr payload)))
            (cdr payload))
           (else 'unknown))))))

(define (busctl seconds . arguments)
  (apply invoke %busctl seconds
         (append
          '("--system" "--no-pager"
            "--allow-interactive-authorization=yes")
          (list (string-append "--timeout=" (number->string seconds)))
          arguments)))

(define (property path interface name)
  (let ((result
         (busctl 5 "get-property" %bluez-service path interface name)))
    (if (eq? (result-kind result) 'ok)
        (decode-property (result-output result))
        'unknown)))

(define (bluez-tree)
  (invoke %busctl 5 "--system" "--no-pager" "--list"
          "tree" %bluez-service))

(define (paths-from-tree result)
  (if (eq? (result-kind result) 'ok)
      (filter (lambda (line) (string-prefix? "/" line))
              (string-split (result-output result) #\newline))
      '()))

(define (tree-paths)
  (paths-from-tree (bluez-tree)))

(define (hex-pair? text)
  (and (= (string-length text) 2)
       (every
        (lambda (character)
          (char-set-contains? char-set:hex-digit character))
        (string->list text))))

(define (adapter-name? text)
  (and (string-prefix? "hci" text)
       (> (string-length text) 3)
       (every char-numeric? (string->list (string-drop text 3)))))

(define (adapter-path? path)
  (match (string-split path #\/)
    (("" "org" "bluez" adapter) (adapter-name? adapter))
    (_ #f)))

(define (device-path? path)
  (match (string-split path #\/)
    (("" "org" "bluez" adapter device)
     (and (adapter-name? adapter)
          (string-prefix? "dev_" device)
          (let ((parts (string-split (string-drop device 4) #\_)))
            (and (= (length parts) 6)
                 (every hex-pair? parts)))))
    (_ #f)))

(define (valid-address? address)
  (let ((parts (string-split address #\:)))
    (and (= (length parts) 6)
         (every hex-pair? parts))))

(define (normalize-address address)
  (and (string? address) (valid-address? address) (string-upcase address)))

(define (address->path adapter address)
  (string-append
   adapter "/dev_"
   (string-map (lambda (character)
                 (if (char=? character #\:) #\_ character))
               (string-upcase address))))

(define (adapter-paths paths)
  (filter adapter-path? paths))

(define (device-paths paths)
  (filter device-path? paths))

(define (device-record path)
  (let* ((address (property path %device-interface "Address"))
         (alias (property path %device-interface "Alias"))
         (paired (property path %device-interface "Paired"))
         (trusted (property path %device-interface "Trusted"))
         (connected (property path %device-interface "Connected"))
         (uuids (property path %device-interface "UUIDs"))
         (battery (property path "org.bluez.Battery1" "Percentage"))
         (audio
          (if (list? uuids)
              (if (member %audio-sink-uuid uuids) 'yes 'no)
              'unknown)))
    (list
     (list 'path path)
     (list 'address address)
     (list 'alias (if (string? alias) alias address))
     (list 'paired paired)
     (list 'trusted trusted)
     (list 'connected connected)
     (list 'audio audio)
     (list 'battery battery))))

(define (build-snapshot)
  (let* ((tree (bluez-tree))
         (paths (paths-from-tree tree))
         (adapters (adapter-paths paths))
         (devices (map device-record (device-paths paths)))
         (adapter
          (cond
           ((not (eq? (result-kind tree) 'ok))
            '((state unavailable) (path unknown) (alias unknown)
              (powered unknown) (discovering unknown)))
           ((= (length adapters) 1)
            (let ((path (car adapters)))
              (list
               (list 'state 'present)
               (list 'path path)
               (list 'alias (property path %adapter-interface "Alias"))
               (list 'powered
                     (property path %adapter-interface "Powered"))
               (list 'discovering
                     (property path %adapter-interface "Discovering")))))
           ((null? adapters)
            '((state absent) (path unknown) (alias unknown)
              (powered unknown) (discovering unknown)))
           (else
            '((state unknown) (path unknown) (alias unknown)
              (powered unknown) (discovering unknown))))))
    (list 'sk-bluetooth/v1
          (cons 'adapter adapter)
          (cons 'devices devices))))

(define (emit-snapshot)
  (write (build-snapshot))
  (newline))

(define (require-adapter)
  (let ((adapters (adapter-paths (tree-paths))))
    (unless (= (length adapters) 1)
      (fail "exactly one Bluetooth adapter is required"))
    (car adapters)))

(define (require-device address)
  (let* ((normalized (normalize-address address))
         (adapter (require-adapter))
         (path (and normalized (address->path adapter normalized))))
    (unless normalized
      (fail "invalid Bluetooth address"))
    (unless (member path (device-paths (tree-paths)))
      (fail "Bluetooth device is not currently known"))
    (cons normalized path)))

(define (set-boolean-property path interface name enabled?)
  (require-ok
   (busctl 8 "set-property" %bluez-service path interface name "b"
           (if enabled? "true" "false"))
   (string-append "setting " name)))

(define (call-device path method . signature-and-arguments)
  (require-ok
   (apply busctl 15 "call" %bluez-service path %device-interface method
          signature-and-arguments)
   method))

(define (ensure-powered)
  (let ((adapter (require-adapter)))
    (if (eq? (property adapter %adapter-interface "Powered") 'yes)
        adapter
        (begin
          (set-boolean-property adapter %adapter-interface "Powered" #t)
          (sleep 1)
          adapter))))

(define (power enabled?)
  (let ((adapter (require-adapter)))
    (unless (eq? (property adapter %adapter-interface "Powered")
                 (if enabled? 'yes 'no))
      (set-boolean-property adapter %adapter-interface "Powered" enabled?))))

(define (scan seconds)
  (ensure-powered)
  (require-ok
   (invoke %bluetoothctl (+ seconds 2)
           "--timeout" (number->string seconds) "scan" "on")
   "Bluetooth scan"))

(define (pair address)
  (ensure-powered)
  (let* ((device (require-device address))
         (normalized (car device))
         (path (cdr device)))
    (unless (eq? (property path %device-interface "Paired") 'yes)
      (require-ok
       (invoke %bluetoothctl 32
               "--timeout" "30" "--agent" "NoInputNoOutput"
               "pair" normalized)
       "pairing"))))

(define (trust address enabled?)
  (let* ((device (require-device address))
         (path (cdr device)))
    (unless (eq? (property path %device-interface "Trusted")
                 (if enabled? 'yes 'no))
      (set-boolean-property path %device-interface "Trusted" enabled?))))

(define (connect address)
  (ensure-powered)
  (let* ((device (require-device address))
         (path (cdr device)))
    (unless (eq? (property path %device-interface "Connected") 'yes)
      (call-device path "Connect"))))

(define (disconnect address)
  (let* ((device (require-device address))
         (path (cdr device)))
    (when (eq? (property path %device-interface "Connected") 'yes)
      (call-device path "Disconnect"))))

(define (connect-audio-profile address)
  (ensure-powered)
  (let* ((device (require-device address))
         (path (cdr device)))
    (call-device path "ConnectProfile" "s" %audio-sink-uuid)))

(define (reconnect address)
  (connect address))

(define (parse-scan-seconds text)
  (let ((number (string->number text)))
    (and (integer? number) (<= 1 number 30) number)))

(define (usage port)
  (format port
          (string-append
           "usage: ~a status|power on|off|scan [1..30]|pair ADDRESS|"
           "trust ADDRESS on|off|connect ADDRESS|disconnect ADDRESS|"
           "profile ADDRESS audio|reconnect ADDRESS~%")
          %program))

(define (dispatch arguments)
  (match arguments
    (("status") #t)
    (("power" "on") (power #t))
    (("power" "off") (power #f))
    (("scan") (scan 10))
    (("scan" seconds)
     (let ((value (parse-scan-seconds seconds)))
       (unless value (fail "scan duration must be between 1 and 30 seconds"))
       (scan value)))
    (("pair" address) (pair address))
    (("trust" address "on") (trust address #t))
    (("trust" address "off") (trust address #f))
    (("connect" address) (connect address))
    (("disconnect" address) (disconnect address))
    (("profile" address "audio") (connect-audio-profile address))
    (("reconnect" address) (reconnect address))
    (_ (fail "invalid arguments")))
  (emit-snapshot))

(define (main arguments)
  (cond
   ((equal? arguments '("--help"))
    (usage (current-output-port))
    0)
   (else
    (catch #t
      (lambda ()
        (dispatch arguments)
        0)
      (lambda (key . payload)
        (if (and (eq? key 'sk-bluetooth-error)
                 (= (length payload) 1)
                 (string? (car payload)))
            (format (current-error-port) "~a: ~a~%"
                    %program (car payload))
            (format (current-error-port) "~a: unexpected failure~%"
                    %program))
        (when (or (null? arguments)
                  (and (pair? payload)
                       (equal? (car payload) "invalid arguments")))
          (usage (current-error-port)))
        1)))))

(when (string=? (basename (car (command-line))) %program)
  (exit (main (cdr (command-line)))))
